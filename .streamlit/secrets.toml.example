# Copie para .streamlit/secrets.toml e preencha com os dados do seu projeto no Supabase.
# NUNCA faça commit do secrets.toml.
SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_KEY = "sua-anon-key"

# Juiz principal (IA open source, licença OSI) por API compatível com a da OpenAI. Escolha UMA opção:
# 1) No computador, com o Ollama (https://ollama.com) e `ollama pull qwen2.5vl:7b` (Apache 2.0):
VISAO_URL = "http://localhost:11434/v1"
# VISAO_MODELO = "qwen2.5vl:7b"
# 2) No Streamlit Cloud, pela API da Mistral (chave em https://console.mistral.ai), Mistral Small (Apache 2.0):
# VISAO_URL = "https://api.mistral.ai/v1"
# VISAO_CHAVE = "sua-chave-da-mistral"
# VISAO_MODELO = "mistral-small-latest"
